{
  "name": "vch-sampling-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VCH soil sampling — sampler PWA, plan-point ingest tool, sync spine",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vite.config.ts",
    "test:e2e": "PLAYWRIGHT_CHROMIUM_PATH=${PLAYWRIGHT_CHROMIUM_PATH:-/opt/pw-browsers/chromium-1194/chrome-linux/chrome} playwright test",
    "db:migrate": "tsx tools/deploy-ddl.ts --target=postgres",
    "db:migrate:dry": "tsx tools/deploy-ddl.ts --target=postgres --dry-run",
    "db:migrate:deploy": "node tools/migrate-on-deploy.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "netlify:dev": "netlify dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "^8.1.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "exifr": "^7.1.3",
    "jose": "^5.9.6",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "uuidv7": "^1.0.2",
    "wa-sqlite": "^1.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^25.0.1",
    "netlify-cli": "^17.38.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
